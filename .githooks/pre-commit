"""Pre-commit hook: enforce >=1000 line net changes per commit.
SKIP_SIZE_CHECK=1 or --no-verify to bypass."""
import os, subprocess, sys

THRESHOLD = 1000
if os.environ.get("SKIP_SIZE_CHECK"):
    sys.exit(0)

r = subprocess.run(["git", "diff", "--cached", "--stat"], capture_output=True, text=True, timeout=10)
if not r.stdout.strip():
    sys.exit(0)

lines = r.stdout.strip().split("\n")
last = lines[-1] if lines else ""
if "file changed" not in last and "files changed" not in last:
    sys.exit(0)

total = 0
for part in last.split(","):
    p = part.strip()
    for kw in ("insertion", "deletion", "change"):
        if kw in p:
            try:
                total += int(p.split()[0])
            except (ValueError, IndexError):
                pass

if total < THRESHOLD:
    print()
    print(f"  BLOCKED: net change ({total} lines) < threshold ({THRESHOLD} lines)")
    print(f"  Use: SKIP_SIZE_CHECK=1 git commit ...")
    print(f"  Or:  git commit --no-verify ...")
    print()
    sys.exit(1)
