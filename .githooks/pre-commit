#!/usr/bin/env bash
# Pre-commit hook — lint + format + size check.
set -euo pipefail

echo "--- pre-commit: ruff check ---"
ruff check --fix --exit-non-zero-on-fix src/ tests/

echo "--- pre-commit: ruff format ---"
ruff format src/ tests/

echo "--- pre-commit: size check ---"
python scripts/pre-commit-size-check
