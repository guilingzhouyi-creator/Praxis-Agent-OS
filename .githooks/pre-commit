#!/usr/bin/env bash
# Pre-commit hook — lint + format + size check + mainline whitelist gate.
#
# Ruff passes are scoped to STAGED .py files only (never the whole tree):
# a whole-tree pass silently reformats files outside the commit and pollutes
# the working tree on every commit. Lint may auto-fix a staged file (aborting
# the commit so the agent re-stages); format is a verify-only gate — the agent
# must run `ruff format <files>` before staging.
set -euo pipefail

echo "--- pre-commit: ruff check (staged .py only) ---"
STAGED_PY="$(git diff --cached --name-only --diff-filter=ACMR -- '*.py' || true)"
if [ -n "$STAGED_PY" ]; then
  # Auto-fixes abort the commit (--exit-non-zero-on-fix): re-stage the fixed
  # files and retry. Files outside the staged set are never touched.
  printf '%s\n' "$STAGED_PY" | xargs ruff check --fix --exit-non-zero-on-fix

  echo "--- pre-commit: ruff format --check (staged .py only) ---"
  printf '%s\n' "$STAGED_PY" | xargs ruff format --check
else
  echo "no staged Python files — ruff skipped"
fi

echo "--- pre-commit: size check ---"
python scripts/pre-commit-size-check

# ── Mainline whitelist gate ─────────────────────────────────────────────
# Only low-risk files may be committed directly on main; everything else
# (src/ code, tests/, shared files) MUST go through a feature branch and the
# double-green merge flow.  This turns the "semi-finished work never enters
# mainline" rule into a hard gate.
BRANCH="$(git branch --show-current 2>/dev/null || echo "")"
if [ "$BRANCH" = "main" ]; then
  STAGED="$(git diff --cached --name-only 2>/dev/null || true)"
  if [ -n "$STAGED" ]; then
    VIOLATIONS="$(printf '%s\n' "$STAGED" | grep -vE '^(docs/|README\.md$|config/|locales/|\.githooks/|scripts/|\.pre-commit-config\.yaml$|\.praxis-rules\.md$|coverage\.xml$)' || true)"
    if [ -n "$VIOLATIONS" ]; then
      echo ""
      echo "--- pre-commit: MAINLINE WHITELIST VIOLATION ---"
      echo "Direct commits to main are limited to low-risk files:"
      echo "  docs/  README.md  config/  locales/  .githooks/  scripts/  .pre-commit-config.yaml  .praxis-rules.md"
      echo "Blocked files (must go through a feature branch + double-green merge):"
      printf '%s\n' "$VIOLATIONS" | sed 's/^/  ✗ /'
      echo "Fix: git switch -c feature/<agent>-<area>  then commit there,"
      echo "     or move the low-risk subset only."
      exit 1
    fi
  fi
fi
